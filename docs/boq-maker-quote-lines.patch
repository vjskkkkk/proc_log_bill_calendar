+
   it('carries no figures at all (CLAUDE.md rule 3)', async () => {
     const body = (await (await list()).json()) as any;
     expect(containsCostFields(body)).toEqual([]);
diff --git a/worker/services/planner.ts b/worker/services/planner.ts
index ec47156..69d6536 100644
--- a/worker/services/planner.ts
+++ b/worker/services/planner.ts
@@ -3,7 +3,7 @@
  * quotes, reading this list over its `BOQ` service binding with the shared INTEGRATION_SECRET. Like the CRM status
  * feed it carries no money at all — not even selling figures (CLAUDE.md rule 3) — only what names a project.
  */
-import { and, desc, isNotNull, ne } from 'drizzle-orm';
+import { and, asc, desc, eq, isNotNull, ne } from 'drizzle-orm';
 import type { QuoteStatus } from '@shared/schemas/quote';
 import { schema, type Db } from '../db/client';
 import { displayQuoteNo } from './numbering';
@@ -54,3 +54,51 @@ export async function plannerQuotes(d: Db, opts: { q?: string; limit?: number }
     .sort((a, b) => (b.pdfIssuedAt ?? '').localeCompare(a.pdfIssuedAt ?? ''))
     .slice(0, limit);
 }
+
+export interface PlannerQuoteLine {
+  id: string;
+  area: string;
+  sport: string;
+  code: string;
+  name: string;
+  unit: string;
+  qty: number;
+  optional: boolean;
+  /** BOQ catalogue category and sub-category of the line's item ('' for a free-typed line). */
+  category: string;
+  subCategory: string;
+}
+
+/**
+ * The line items of one issued quote, for Koochie Calendar to draft a project's Gantt from (PLAN §11): what is being
+ * supplied and how much — names, units and quantities only, never a rate or an amount. Drafts and cancelled quotes
+ * are not served (null → 404).
+ */
+export async function plannerQuoteLines(d: Db, quoteId: string): Promise<{ quote: PlannerQuote; lines: PlannerQuoteLine[] } | null> {
+  const [q] = await d
+    .select({
+      id: schema.quotes.id, rootQuoteId: schema.quotes.rootQuoteId, quoteNo: schema.quotes.quoteNo, revision: schema.quotes.revision,
+      status: schema.quotes.status, quoteType: schema.quotes.quoteType, clientCompany: schema.quotes.clientCompany,
+      clientName: schema.quotes.clientName, projectName: schema.quotes.projectName, location: schema.quotes.location,
+      crmLeadId: schema.quotes.crmLeadId, pdfIssuedAt: schema.quotes.pdfIssuedAt,
+    })
+    .from(schema.quotes)
+    .where(and(eq(schema.quotes.id, quoteId), isNotNull(schema.quotes.pdfIssuedAt), ne(schema.quotes.status, 'cancelled')));
+  if (!q) return null;
+  const rows = await d
+    .select({
+      id: schema.quoteLines.id, area: schema.quoteAreas.name, sport: schema.quoteAreas.sport, code: schema.quoteLines.code,
+      name: schema.quoteLines.name, unit: schema.quoteLines.unit, qty: schema.quoteLines.qty, optional: schema.quoteLines.isOptional,
+      category: schema.catalogCategories.name, subCategory: schema.catalogItems.subCategory,
+    })
+    .from(schema.quoteLines)
+    .innerJoin(schema.quoteAreas, eq(schema.quoteAreas.id, schema.quoteLines.areaId))
+    .leftJoin(schema.catalogItems, eq(schema.catalogItems.id, schema.quoteLines.catalogItemId))
+    .leftJoin(schema.catalogCategories, eq(schema.catalogCategories.id, schema.catalogItems.categoryId))
+    .where(eq(schema.quoteAreas.quoteId, quoteId))
+    .orderBy(asc(schema.quoteAreas.sort), asc(schema.quoteLines.sort));
+  return {
+    quote: { ...q, displayNo: displayQuoteNo(q.quoteNo, q.revision) },
+    lines: rows.map((r) => ({ ...r, optional: !!r.optional, category: r.category ?? '', subCategory: r.subCategory ?? '' })),
+  };
+}
