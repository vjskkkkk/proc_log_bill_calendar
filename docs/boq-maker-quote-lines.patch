From 6223de4fa2af257b7339d519f6753430ba642e2a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 20 Oct 2026 13:25:50 +0530
Subject: [PATCH] Calendar link: an issued quote's line items for drafting its
 Gantt, no figures
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

GET /api/integration/planner/quotes/:id/lines (behind the INTEGRATION_SECRET guard) returns the quote and its lines:
area, code, name, unit, quantity, optional, catalogue category/sub-category. No rates, margins or amounts. Drafts and
cancelled quotes answer 404. Read by koochie-calendar to draft a project's tasks from its quote (PLAN §11).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 worker/routes/crm.ts          |  9 ++++++-
 worker/routes/planner.test.ts | 16 +++++++++++
 worker/services/planner.ts    | 50 ++++++++++++++++++++++++++++++++++-
 3 files changed, 73 insertions(+), 2 deletions(-)

diff --git a/worker/routes/crm.ts b/worker/routes/crm.ts
index 1b7aab3..a036c45 100644
--- a/worker/routes/crm.ts
+++ b/worker/routes/crm.ts
@@ -6,7 +6,7 @@ import { crmStatus, fetchLead, fetchLeads, INTEGRATION_HEADER, latestQuoteForLea
 import { createQuote } from '../services/quotes/create';
 import { getQuoteRow, loadQuote, logEvent } from '../services/quotes/load';
 import { redactForRole } from '../services/redact';
-import { plannerQuotes } from '../services/planner';
+import { plannerQuoteLines, plannerQuotes } from '../services/planner';
 import { quoteErrorHandler } from './quote-areas';
 
 const LEAD_ID = /^[\w-]{1,100}$/;
@@ -76,3 +76,10 @@ integrationRoutes.get('/planner/quotes', async (c) => {
   const limit = Number(c.req.query('limit') ?? '') || undefined;
   return c.json({ quotes: await plannerQuotes(db(c.env.DB), { q: c.req.query('q') ?? '', limit }) });
 });
+
+/** One issued quote's line items (names, units, quantities — no figures) for drafting its project's Gantt (PLAN §11). */
+integrationRoutes.get('/planner/quotes/:id/lines', async (c) => {
+  c.header('Cache-Control', 'no-store');
+  const found = await plannerQuoteLines(db(c.env.DB), c.req.param('id'));
+  return found ? c.json(found) : c.json({ error: 'Not found' }, 404);
+});
