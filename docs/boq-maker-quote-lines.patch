+    expect(body.lines).toEqual([{ id: expect.any(String), area: 'COURT', sport: '', code: '', name: 'Item', unit: 'Sqft', qty: 10, optional: false, category: '', subCategory: '' }]);
+    expect(containsCostFields(body)).toEqual([]);
+    expect(JSON.stringify(Object.keys(body.lines[0]))).not.toMatch(/rate|margin|overhead|amount|total|price/i);
+    const draft = (await (await req('/api/quotes', json('POST', { projectName: 'Draft only' }, admin))).json()) as any;
